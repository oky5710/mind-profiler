#!/usr/bin/env bash
set -euo pipefail

if [ "${AI_REVIEW_SKIP_HOOK:-}" = "1" ]; then
    exit 0
fi

# 커밋할 때마다 방금 만든 커밋을 codex에게 리뷰받는다. codex 리뷰가 수십 초씩 걸릴 수 있어서
# git commit 자체를 막지 않도록 백그라운드로 돌리고, 결과는 .ai-review/codex-review.md에
# 저장한다. Codex 리뷰가 끝나면 Claude CLI가 이어서 .ai-review/claude-response.md에 응답한다.
#
# git은 훅 자체를 커밋에 포함시켜 공유하지 않으므로, 이 파일은 참고용 원본이고 실제로 동작하는
# 건 .git/hooks/post-commit(이 파일을 복사해 둔 것)이다 — 새로 클론했다면
# `cp scripts/hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit`로 다시 설치한다.

repo_root=$(git rev-parse --show-toplevel)
sha=$(git rev-parse HEAD)

# .ai-review/는 gitignore돼 있어서 새로 클론한 직후엔 아직 없다 — 리다이렉트 대상 디렉터리가
# 없으면 그 자체로 셸이 리다이렉트를 열지 못해 아래 명령이 아예 시작되지 않는다.
mkdir -p "$repo_root/.ai-review"

nohup "$repo_root/scripts/ai-review.sh" --commit "$sha" > "$repo_root/.ai-review/last-run.log" 2>&1 &
disown
